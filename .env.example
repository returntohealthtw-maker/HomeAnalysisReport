# Google Gemini API Key (required)
# 免費申請：https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Server settings (optional)
PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key


# --- Brainwave database import (optional) ---
# Admin APP key issued by the database project owner (server-side only, never expose to the browser)
BRAINDB_SERVICE_KEY=
# Shared password staff must type before using the database import (personal health data!)
BRAINDB_IMPORT_PASSWORD=
# Defaults to the production Cloud Functions API
# BRAINDB_API_BASE=https://api-ltdbufxedq-de.a.run.app/api
